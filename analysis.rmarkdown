---
title: "Analyzing US Census Data"
format: html
auhtor: Alexa Titherington
execute:
  echo: false
---

```{r}
#| message: false
library(tidyverse)
library(tidycensus)
library(sf)
```

```{r}
#| message: false
#| cache: true
income_tx <- get_acs(
  geography = "county",
  variables = "B19013_001",
  state = "TX",
  year = 2020,
  geometry = TRUE
)
```

```{r}
ggplot(income_tx) +
  geom_sf(aes(fill = estimate), color = "white", linewidth = 0.1) +
  scale_fill_viridis_c(
    option = "viridis",
    labels = scales::label_dollar()
  ) +
  labs(
    title = "Median Household Income by Texas County",
    fill = "Median household income (USD)",
    caption = "Source: U.S. Census Bureau, 2020 American Community Survey 5-year estimates (B19013_001)."
  ) +
  theme_void() +
  theme(
    plot.title = element_text(face = "bold"),
    plot.caption = element_text(hjust = 0)
  )
```

```{r}
#| message: false
edu_state <- get_acs(
  geography = "state",
  variables = c(
    "B15003_001",
    "B15003_022",
    "B15003_023",
    "B15003_024",
    "B15003_025"
  ),
  summary_var = "B15003_001",
  year = 2020
)
```

```{r}
#| fig-height: 9
edu_state_summary <- edu_state |>
  group_by(GEOID, NAME) |>
  summarize(
    percent_bachelors_plus =
      sum(estimate[variable %in% c(
        "B15003_022",
        "B15003_023",
        "B15003_024",
        "B15003_025"
      )], na.rm = TRUE) / first(summary_est) * 100,
    .groups = "drop"
  ) |>
  arrange(desc(percent_bachelors_plus))

ggplot(
  edu_state_summary,
  aes(
    x = percent_bachelors_plus,
    y = forcats::fct_reorder(NAME, percent_bachelors_plus)
  )
) +
  geom_col(fill = "steelblue") +
  scale_x_continuous(labels = scales::label_percent(scale = 1)) +
  labs(
    title = "Bachelor's Degree or Higher by State",
    x = "Adults age 25 and older with a bachelor's degree or higher",
    y = NULL,
    caption = "Source: U.S. Census Bureau, 2020 American Community Survey 5-year estimates (table B15003)."
  ) +
  theme_minimal() +
  theme(
    plot.title = element_text(face = "bold"),
    plot.caption = element_text(hjust = 0),
    panel.grid.major.y = element_blank(),
    panel.grid.minor = element_blank()
  )
```

```{r}
#| message: false
age_ca <- get_acs(
  geography = "county",
  variables = c(
    median_age = "B01002_001",
    population = "B01003_001"
  ),
  state = "CA",
  year = 2020,
  geometry = FALSE
)
```

```{r}
age_ca
